---
import Base from '../layouts/Base.astro';
import { SUPPORT_EMAIL } from '../lib/games';

const faq = [
  {
    q: 'How do I remove ads?',
    a: 'Watch rewarded ads in the <strong>Settings</strong> screen. After watching enough ads, they are removed permanently for free — no purchase required.',
  },
  {
    q: 'I lost my progress. Can I get it back?',
    a: "Progress is saved locally on your device. If you reinstalled the app or cleared its data, progress cannot be recovered. We're working on cloud save for a future update.",
  },
  {
    q: "The app crashes or won't open.",
    a: `Try restarting your device and reopening the app. If the issue persists, email us at <a href="mailto:${SUPPORT_EMAIL}" class="underline">${SUPPORT_EMAIL}</a> with your device model and iOS version.`,
  },
  {
    q: 'How do I reset my progress?',
    a: 'Go to <strong>Settings → Progress → Reset Progress</strong>. Note: this cannot be undone.',
  },
  {
    q: 'What is the Generator?',
    a: 'The Generator lets you create custom puzzle boards with different sizes and shapes. It unlocks automatically after reaching a certain level in the main game.',
  },
];
---

<Base title="Support | Emberfox Games" description="Help and frequently asked questions for Arrows Untangle by Emberfox Games.">
  <div class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <a href="/" class="inline-flex items-center gap-2 text-sm font-semibold text-stone-400 hover:text-white">← Back to all games</a>

    <div class="mt-6 text-center">
      <h1 class="text-4xl font-extrabold tracking-tight text-white">Arrows Untangle — Support</h1>
      <p class="mt-3 text-lg text-stone-400">We're happy to help with any questions or issues.</p>
    </div>

    <div class="mt-10 rounded-3xl bg-ink-800 p-8 text-center ring-1 ring-white/10">
      <h2 class="text-2xl font-extrabold text-white">Get in touch</h2>
      <p class="mt-2 text-stone-400">Send us an email and we'll get back to you as soon as possible.</p>
      <a href={`mailto:${SUPPORT_EMAIL}?subject=Arrows%20iOS%20support`} data-conversion
        class="mt-6 inline-block rounded-xl bg-ember-500 px-8 py-4 text-lg font-semibold text-ink-900 transition hover:bg-ember-400">
        ✉ {SUPPORT_EMAIL}
      </a>
    </div>

    <h2 class="mt-12 text-2xl font-extrabold text-white">Frequently asked questions</h2>
    <div class="mt-6 flex flex-col gap-3">
      {faq.map(({ q, a }) => (
        <details class="group rounded-2xl bg-ink-800 ring-1 ring-white/5 open:ring-white/15">
          <summary class="flex cursor-pointer list-none items-center justify-between p-5 text-lg font-semibold text-white [&::-webkit-details-marker]:hidden">
            {q}
            <span class="text-2xl text-stone-500 transition group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <div class="border-t border-white/10 px-5 pb-5 pt-4 text-stone-300" set:html={a} />
        </details>
      ))}
    </div>
  </div>
</Base>
