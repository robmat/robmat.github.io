---
import '../styles/global.css';
import { PLAY_DEVELOPER_URL } from '../lib/games';

type Props = { title: string; description: string };
const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/media/emberfox.png', Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#120f0d" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Emberfox Games" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary" />

    <!-- Google Ads with Consent Mode v2. Everything defaults to denied until the visitor accepts. -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=AW-959467352"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }

      // Enhanced conversions are deliberately fed a random, throwaway email (existing behavior, see CLAUDE.md).
      (function () {
        const chars = 'abcdefghijklmnopqrstuvwxyz0123456789';
        const rand = (min, max) => Math.floor(Math.random() * (max - min + 1)) + min;
        const str = (n) => Array.from({ length: n }, () => chars[Math.floor(Math.random() * chars.length)]).join('');
        gtag('set', 'user_data', { email: `${str(rand(5, 10))}@${str(rand(5, 10))}.${str(rand(2, 3))}` });
      })();

      gtag('consent', 'default', {
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        ad_storage: 'denied',
        analytics_storage: 'denied',
        wait_for_update: 500,
      });

      window.emberfoxConsent = {
        read() {
          try {
            const v = localStorage.getItem('consent');
            if (v) return v;
            // Visitors who accepted on the old page.
            if (localStorage.getItem('consentGranted') === 'true') return 'granted';
          } catch (e) {}
          return null;
        },
        apply(value) {
          const state = value === 'granted' ? 'granted' : 'denied';
          gtag('consent', 'update', {
            ad_user_data: state,
            ad_personalization: state,
            ad_storage: state,
            analytics_storage: state,
          });
        },
        save(value) {
          try { localStorage.setItem('consent', value); } catch (e) {}
          this.apply(value);
        },
      };
      if (window.emberfoxConsent.read() === 'granted') window.emberfoxConsent.apply('granted');

      gtag('js', new Date());
      gtag('config', 'AW-959467352', { allow_enhanced_conversions: true });
    </script>
  </head>

  <body class="bg-ink-900 font-sans text-stone-200 antialiased">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-white focus:px-4 focus:py-2 focus:text-ink-900">Skip to content</a>

    <header class="sticky top-0 z-40 border-b border-white/5 bg-ink-900/80 backdrop-blur">
      <nav class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6" aria-label="Main">
        <a href="/" class="flex items-center gap-3">
          <img src="/media/emberfox.png" alt="" width="36" height="36" class="h-9 w-9 rounded-lg" />
          <span class="font-extrabold tracking-tight text-white">Emberfox<span class="text-ember-400"> Games</span></span>
        </a>
        <div class="flex items-center gap-1 text-sm sm:gap-6">
          <a href="/#games" class="hidden hover:text-white sm:inline">Games</a>
          <a href="/support.html" class="hidden hover:text-white sm:inline">Support</a>
          <a href="/#contact" class="hidden hover:text-white sm:inline">Contact</a>
          <a href={PLAY_DEVELOPER_URL} data-conversion class="rounded-full bg-ember-500 px-4 py-2 font-semibold text-ink-900 transition hover:bg-ember-400">Google Play</a>
        </div>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="border-t border-white/5">
      <div class="mx-auto flex max-w-7xl flex-col justify-between gap-4 px-4 py-8 text-sm text-stone-500 sm:flex-row sm:px-6">
        <p>© {new Date().getFullYear()} Emberfox Games</p>
        <div class="flex gap-6">
          <a href="/support.html" class="hover:text-stone-300">Support</a>
          <a href="/privacy_policy.html" class="hover:text-stone-300">Privacy policy</a>
          <button type="button" data-open-consent class="hover:text-stone-300">Cookie settings</button>
        </div>
      </div>
    </footer>

    <div id="consent" hidden role="dialog" aria-label="Cookie consent"
      class="fixed inset-x-4 bottom-4 z-50 rounded-2xl bg-ink-800 p-5 shadow-2xl shadow-black/60 ring-1 ring-white/10 sm:left-auto sm:right-4 sm:max-w-sm">
      <p class="text-sm text-stone-300">
        We use cookies to measure which games people are interested in.
        <a href="/privacy_policy.html" class="underline">Privacy policy</a>
      </p>
      <div class="mt-4 grid grid-cols-2 gap-2">
        <button type="button" data-consent="denied" class="rounded-lg py-2 font-semibold ring-1 ring-white/20 hover:bg-white/5">Reject</button>
        <button type="button" data-consent="granted" class="rounded-lg bg-ember-500 py-2 font-semibold text-ink-900 hover:bg-ember-400">Accept</button>
      </div>
    </div>

    <script>
      const banner = document.getElementById('consent')!;
      const consent = (window as any).emberfoxConsent;
      if (!consent.read()) banner.hidden = false;

      document.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        const choice = target.closest<HTMLElement>('[data-consent]');
        if (choice) {
          consent.save(choice.dataset.consent);
          banner.hidden = true;
        }
        if (target.closest('[data-open-consent]')) banner.hidden = false;

        // Every outbound store / contact link counts as a Google Ads conversion.
        if (target.closest('a[data-conversion]')) {
          (window as any).gtag('event', 'conversion', { send_to: 'AW-959467352/Q5itCPisiaUYENiewckD' });
        }
      });
    </script>
  </body>
</html>
