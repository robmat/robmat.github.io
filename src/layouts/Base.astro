---
import '../styles/global.css';
import { PLAY_DEVELOPER_URL } from '../lib/games';

type Props = { title: string; description: string };
const { title, description } = Astro.props;
// build.format 'file' makes the home page /index.html; the canonical form is /.
const canonical = new URL(Astro.url.pathname.replace(/(^|\/)index(\.html)?$/, '$1'), Astro.site);
const ogImage = new URL('/media/emberfox.png', Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0a0807" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Emberfox Games" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary" />
    <script is:inline>document.documentElement.classList.add('js');</script>

    <!-- Google Ads with Consent Mode v2. Everything defaults to denied until the visitor accepts. -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=AW-959467352"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }

      // Enhanced conversions are deliberately fed a random, throwaway email (existing behavior, see CLAUDE.md).
      (function () {
        const chars = 'abcdefghijklmnopqrstuvwxyz0123456789';
        const rand = (min, max) => Math.floor(Math.random() * (max - min + 1)) + min;
        const str = (n) => Array.from({ length: n }, () => chars[Math.floor(Math.random() * chars.length)]).join('');
        gtag('set', 'user_data', { email: `${str(rand(5, 10))}@${str(rand(5, 10))}.${str(rand(2, 3))}` });
      })();

      gtag('consent', 'default', {
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        ad_storage: 'denied',
        analytics_storage: 'denied',
        wait_for_update: 500,
      });

      window.emberfoxConsent = {
        read() {
          try {
            const v = localStorage.getItem('consent');
            if (v) return v;
            // Visitors who accepted on the old page.
            if (localStorage.getItem('consentGranted') === 'true') return 'granted';
          } catch (e) {}
          return null;
        },
        apply(value) {
          const state = value === 'granted' ? 'granted' : 'denied';
          gtag('consent', 'update', {
            ad_user_data: state,
            ad_personalization: state,
            ad_storage: state,
            analytics_storage: state,
          });
        },
        save(value) {
          try { localStorage.setItem('consent', value); } catch (e) {}
          this.apply(value);
        },
      };
      if (window.emberfoxConsent.read() === 'granted') window.emberfoxConsent.apply('granted');

      gtag('js', new Date());
      gtag('config', 'AW-959467352', { allow_enhanced_conversions: true });
    </script>
  </head>

  <body class="bg-ink-950 font-sans text-stone-300 antialiased">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[90] focus:rounded-lg focus:bg-white focus:px-4 focus:py-2 focus:text-ink-900">Skip to content</a>
    <div class="progress" aria-hidden="true"></div>
    <div class="grain" aria-hidden="true"></div>

    <header class="site-header group/header fixed inset-x-0 top-0 z-50 px-3 pt-3 sm:px-6 sm:pt-4">
      <nav class="mx-auto flex h-14 max-w-6xl items-center justify-between rounded-full border border-white/10 bg-ink-950/55 pl-2 pr-2 shadow-[0_10px_40px_-10px_rgb(0_0_0/0.8)] backdrop-blur-xl backdrop-saturate-150 sm:pl-3" aria-label="Main">
        <a href="/" class="group flex items-center gap-2.5 rounded-full pr-3">
          <img src="/media/emberfox.png" alt="" width="40" height="40" class="h-10 w-10 rounded-full ring-1 ring-white/10 transition duration-500 group-hover:rotate-[-8deg] group-hover:scale-110" />
          <span class="text-[1.05rem] font-bold tracking-tight text-white">Emberfox<span class="font-serif text-lg font-normal italic text-ember-300"> games</span></span>
        </a>
        <div class="flex items-center gap-1 text-sm font-medium">
          <a href="/#games" class="hidden rounded-full px-4 py-2 text-stone-300 transition hover:bg-white/5 hover:text-white md:inline">Games</a>
          <a href="/#iphone" class="hidden rounded-full px-4 py-2 text-stone-300 transition hover:bg-white/5 hover:text-white md:inline">iPhone</a>
          <a href="/support.html" class="hidden rounded-full px-4 py-2 text-stone-300 transition hover:bg-white/5 hover:text-white md:inline">Support</a>
          <a href="/#contact" class="hidden rounded-full px-4 py-2 text-stone-300 transition hover:bg-white/5 hover:text-white sm:inline">Contact</a>
          <a href={PLAY_DEVELOPER_URL} data-conversion data-magnetic="0.25"
            class="ml-1 inline-flex items-center gap-2 rounded-full bg-ember-500 px-4 py-2 font-semibold text-ink-950 shadow-[0_0_24px_-4px_var(--color-ember-500)] transition-colors hover:bg-ember-400">
            <span data-magnetic-inner>Google Play</span>
          </a>
        </div>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="relative overflow-hidden border-t border-white/5 pt-16">
      <div class="mx-auto flex max-w-7xl flex-col justify-between gap-8 px-4 sm:flex-row sm:px-6">
        <div class="max-w-sm">
          <p class="text-lg font-semibold text-white">Emberfox Games</p>
          <p class="mt-2 text-sm text-stone-500">Indie puzzles, stories and photo apps for Android and iOS.</p>
        </div>
        <div class="flex flex-wrap gap-x-8 gap-y-3 text-sm">
          <a href="/#games" class="text-stone-400 transition hover:text-white">Games</a>
          <a href="/support.html" class="text-stone-400 transition hover:text-white">Support</a>
          <a href="/privacy_policy.html" class="text-stone-400 transition hover:text-white">Privacy policy</a>
          <button type="button" data-open-consent class="text-stone-400 transition hover:text-white">Cookie settings</button>
          <a href={PLAY_DEVELOPER_URL} data-conversion class="text-stone-400 transition hover:text-white">Google Play ↗</a>
        </div>
      </div>
      <div class="mt-10 select-none px-2" aria-hidden="true">
        <p class="wordmark text-center text-[clamp(4rem,19vw,19rem)] leading-[0.8] tracking-[-0.04em]">{[...'EMBERFOX'].map((c) => <span>{c}</span>)}</p>
      </div>
      <p class="mx-auto max-w-7xl px-4 pb-6 pt-4 text-xs text-stone-600 sm:px-6">© {new Date().getFullYear()} Emberfox Games. All game art belongs to its respective games.</p>
    </footer>

    <div id="consent" hidden role="dialog" aria-label="Cookie consent"
      class="fixed inset-x-4 bottom-4 z-[75] rounded-2xl border border-white/10 bg-ink-900/85 p-5 shadow-2xl shadow-black/60 backdrop-blur-xl sm:left-auto sm:right-4 sm:max-w-sm">
      <p class="text-sm text-stone-300">
        We use cookies to measure which games people are interested in.
        <a href="/privacy_policy.html" class="underline">Privacy policy</a>
      </p>
      <div class="mt-4 grid grid-cols-2 gap-2">
        <button type="button" data-consent="denied" class="rounded-full py-2 font-semibold ring-1 ring-white/20 transition hover:bg-white/5">Reject</button>
        <button type="button" data-consent="granted" class="rounded-full bg-ember-500 py-2 font-semibold text-ink-950 transition hover:bg-ember-400">Accept</button>
      </div>
    </div>

    <script>
      import '../scripts/fx';

      const banner = document.getElementById('consent')!;
      const consent = (window as any).emberfoxConsent;
      if (!consent.read()) banner.hidden = false;

      document.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        const choice = target.closest<HTMLElement>('[data-consent]');
        if (choice) {
          consent.save(choice.dataset.consent);
          banner.hidden = true;
        }
        if (target.closest('[data-open-consent]')) banner.hidden = false;

        // Every outbound store / contact link counts as a Google Ads conversion.
        if (target.closest('a[data-conversion]')) {
          (window as any).gtag('event', 'conversion', { send_to: 'AW-959467352/Q5itCPisiaUYENiewckD' });
        }
      });
    </script>
  </body>
</html>
