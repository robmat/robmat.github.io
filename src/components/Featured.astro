---
import { Image } from 'astro:assets';
import PlayIcon from './PlayIcon.astro';
import { games, playUrl } from '../lib/games';

const featured = games.find((g) => g.featured)!;
const sequel = games.find((g) => g.media === 'art_thief2');
const stars = Array.from({ length: 5 }, (_, i) => Math.max(0, Math.min(1, (featured.rating ?? 0) - i)));
---

<section class="relative overflow-hidden py-24 sm:py-32">
  <div class="pointer-events-none absolute left-1/2 top-1/2 -z-10 h-[40rem] w-[60rem] -translate-x-1/2 -translate-y-1/2 rounded-full bg-ember-600/10 blur-[120px]"></div>
  <div class="mx-auto grid max-w-7xl items-center gap-12 px-4 sm:px-6 lg:grid-cols-[1.25fr_1fr] lg:gap-16">
    <a href={playUrl(featured.id)} data-conversion data-cursor="Play"
      class="spot tilt reveal group relative block overflow-hidden rounded-[2rem] shadow-[0_40px_120px_-30px_rgb(242_107_29/0.45)] ring-1 ring-white/10" data-tilt="5">
      <Image src={featured.bannerImage} alt={`${featured.name} artwork`} widths={[640, 1024]} sizes="(min-width: 1024px) 680px, 100vw"
        format="webp" quality={82} class="kenburns aspect-[1024/500] w-full object-cover" />
      <div class="absolute inset-0 bg-gradient-to-t from-ink-950/80 via-transparent to-transparent"></div>
      <span class="absolute left-5 top-5 rounded-full bg-ink-950/60 px-3 py-1 text-xs font-semibold text-ember-200 ring-1 ring-ember-400/40 backdrop-blur">★ Most reviewed</span>
      <div class="absolute bottom-5 left-5 flex items-center gap-3">
        <Image src={featured.icon} alt="" width={56} height={56} densities={[1, 2]} format="webp" class="h-14 w-14 rounded-2xl ring-1 ring-white/20" />
        <span class="text-sm font-semibold text-white">{featured.category} · {featured.contentRating}</span>
      </div>
    </a>

    <div class="reveal" style="--d:120ms">
      <p class="text-xs font-semibold uppercase tracking-[0.3em] text-ember-400">Fan favourite</p>
      <h2 class="mt-4 text-4xl font-bold leading-[0.95] tracking-[-0.03em] text-white sm:text-6xl">
        Girls and Adventures: <span class="font-serif font-normal italic text-ember-300">Morgan</span>
      </h2>
      <div class="mt-7 flex items-center gap-5">
        <p class="font-serif text-7xl leading-none text-white">{featured.rating?.toFixed(1)}</p>
        <div>
          <div class="flex gap-1 text-xl" role="img" aria-label={`Rated ${featured.rating} out of 5`}>
            {stars.map((fill) => (
              <span class="relative text-white/15">★<span class="absolute inset-0 overflow-hidden text-ember-400" style={`width:${fill * 100}%`}>★</span></span>
            ))}
          </div>
          <p class="mt-1 text-sm text-stone-400"><span class="font-semibold text-white" data-count={featured.votes}>{featured.votes}</span> player reviews on Google Play</p>
        </div>
      </div>
      <p class="mt-7 max-w-md text-lg text-stone-400">
        {featured.desc} The most-reviewed game in our catalog.
      </p>
      <div class="mt-9 flex flex-wrap items-center gap-4">
        <a href={playUrl(featured.id)} data-conversion data-magnetic="0.3"
          class="inline-flex items-center gap-3 rounded-full bg-ember-500 py-3.5 pl-4 pr-6 font-semibold text-ink-950 transition-colors hover:bg-ember-400">
          <span data-magnetic-inner class="inline-flex items-center gap-3"><PlayIcon /> Play free</span>
        </a>
        {sequel && (
          <a href={playUrl(sequel.id)} data-conversion class="group inline-flex items-center gap-2 font-semibold text-stone-300 transition hover:text-white">
            Already finished it? Try {sequel.name.split(':')[0]}
            <span class="transition-transform duration-500 group-hover:translate-x-1">→</span>
          </a>
        )}
      </div>
    </div>
  </div>
</section>
